# Copy to .env for local use (or set these in Vercel -> Settings -> Environment Variables).
# You only need ONE key. If several are set they are tried in the order: groq, gemini, openrouter
# (or put LLM_PROVIDER first).

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=

# https://openrouter.ai/keys  (free models available)
OPENROUTER_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# RATE_LIMIT_PER_MIN=30
